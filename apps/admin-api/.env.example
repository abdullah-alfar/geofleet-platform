# Local development environment for admin-api.
# Copy to `.env` and load it (e.g. `export $(grep -v '^#' .env | xargs)`,
# or `npm run start:dev` via a tool like dotenv-cli) before running. Points
# at the same Phase 1 infrastructure the other services use, via
# host-exposed ports.

NODE_ENV=development
HTTP_PORT=3001
LOG_LEVEL=info

# Comma-separated list of admin-web origins allowed to call this API from a
# browser. No default — CORS fails closed if unset.
ADMIN_WEB_ORIGINS=http://localhost:3000

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# admin_api role, broadened by core-api's
# *_broaden_admin_api_role.php migration past auth-only: admin-api now
# reads/writes every business table its commands touch directly, and
# owns admin_sessions outright (its own login/session store — see
# docs/decisions/0011-admin-api-independent-service.md). The password
# here must match ADMIN_API_DB_PASSWORD in apps/core-api/.env — same
# credential, two services.
ADMIN_API_POSTGRES_DSN=postgres://admin_api:change_me_local_dev_admin_api@127.0.0.1:5432/core_api?sslmode=disable
