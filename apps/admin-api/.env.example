# Local development environment for admin-api.
# Copy to `.env` and load it (e.g. `export $(grep -v '^#' .env | xargs)`,
# or `npm run start:dev` via a tool like dotenv-cli) before running. Points
# at the same Phase 1 infrastructure the other services use, via
# host-exposed ports.

NODE_ENV=development
HTTP_PORT=3001
LOG_LEVEL=info

# Comma-separated list of admin-web origins allowed to call this API from a
# browser. No default — CORS fails closed if unset.
ADMIN_WEB_ORIGINS=http://localhost:3000

REDIS_ADDR=127.0.0.1:63790
REDIS_PASSWORD=change_me_local_dev

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
# Not consumed until Phase 4 (projection consumers).
ADMIN_API_CONSUMER_GROUP=admin-api

CORE_API_BASE_URL=http://127.0.0.1:8000
CORE_API_TIMEOUT_MS=3000

# Shared secret sent as X-Internal-Service-Token on internal/v1/* command
# calls (drivers.suspend, trips.cancel, payments.refund). Must match
# ADMIN_API_INTERNAL_TOKEN in apps/core-api's own .env — same credential,
# two services. See docs/decisions/0010-internal-service-authentication.md.
ADMIN_API_INTERNAL_TOKEN=change_me_local_dev_admin_api_internal

# admin_api role created by core-api's
# *_create_admin_api_role.php migration — authentication only
# (personal_access_tokens/users/admins). The password here must match
# ADMIN_API_DB_PASSWORD in apps/core-api/.env — same credential, two
# services. See docs/decisions/0009-admin-identity.md.
ADMIN_API_POSTGRES_DSN=postgres://admin_api:change_me_local_dev_admin_api@127.0.0.1:55432/core_api?sslmode=disable
