# Local development environment for realtime-gateway.
# Copy to `.env` and `export $(grep -v '^#' .env | xargs)` before running.
# Points at the same Phase 1 infrastructure the other services use, via
# host-exposed ports.

HTTP_PORT=8083
LOG_LEVEL=info

# Read-only Postgres role created by apps/core-api's
# 2026_08_09_200000_create_realtime_gateway_role.php migration. The
# password here must match REALTIME_GATEWAY_DB_PASSWORD in
# apps/core-api/.env — same credential, two services.
REALTIME_GATEWAY_POSTGRES_DSN=postgres://realtime_gateway:change_me_local_dev_realtime_gateway@127.0.0.1:55432/core_api?sslmode=disable

REDIS_ADDR=127.0.0.1:63790
REDIS_PASSWORD=change_me_local_dev

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
REALTIME_GATEWAY_CONSUMER_GROUP=realtime-gateway

# TTL-bounded Redis correlation state — see
# docs/decisions/0006-realtime-gateway-fanout.md
RIDE_CORRELATION_TTL=30m
DRIVER_ASSIGNMENT_TTL=4h

WS_PING_INTERVAL=20s
WS_PONG_TIMEOUT=40s
