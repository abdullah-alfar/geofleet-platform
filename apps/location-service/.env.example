# Local development environment for location-service.
# Copy to `.env` and `export $(grep -v '^#' .env | xargs)` before running,
# or use a tool like direnv. Points at the same Phase 1 infrastructure
# core-api uses, via host-exposed ports.

HTTP_PORT=8081
LOG_LEVEL=info

# Least-privilege Postgres role created by apps/core-api's
# 2026_08_06_150000_create_location_service_role.php migration. The
# password here must match LOCATION_SERVICE_DB_PASSWORD in
# apps/core-api/.env — same credential, two services.
LOCATION_SERVICE_POSTGRES_DSN=postgres://location_service:change_me_local_dev_location_service@127.0.0.1:55432/core_api?sslmode=disable

REDIS_ADDR=127.0.0.1:63790
REDIS_PASSWORD=change_me_local_dev

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094

# GPS validation thresholds — see internal/validation and
# docs/architecture/failure-scenarios.md (added in a later phase) for the
# reasoning behind these defaults.
MAX_ACCURACY_METERS=100
MAX_TIMESTAMP_AGE=120s
MAX_FUTURE_SKEW=10s
MAX_PLAUSIBLE_SPEED_MS=60
MAX_UPDATES_PER_WINDOW=2
RATE_LIMIT_WINDOW=1s

DEVICE_CACHE_TTL=30s
LOCATION_TTL=5m
