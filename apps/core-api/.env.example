APP_NAME="Ride-Hailing Core API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default region for local development. Carried onto outbox event envelopes.
REGION_ID=amman
EVENT_PRODUCER=core-api

# Connects to the dockerized postgres from Phase 1 (infrastructure/) via its
# host-mapped port (see repo-root .env.example: POSTGRES_PORT=55432).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=core_api
DB_USERNAME=core_api
DB_PASSWORD=change_me_local_dev

# Least-privilege role for apps/location-service (Go) — read-only on
# driver_devices/drivers/vehicles. Must match apps/location-service's own
# .env DB_PASSWORD (same value, different service). Created by
# database/migrations/2026_08_06_150000_create_location_service_role.php.
LOCATION_SERVICE_DB_PASSWORD=change_me_local_dev_location_service

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Internal Laravel jobs only (emails, reports, low-volume background work) —
# never domain/integration events, which go through Kafka via the outbox.
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (pure-PHP) rather than the phpredis extension, so no extra system
# package is required to run core-api locally.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=change_me_local_dev
REDIS_PORT=63790

# --- Kafka (outbox publisher) ---------------------------------------------
KAFKA_BROKERS=127.0.0.1:9094

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Least-privilege role for apps/dispatch-service (Go) -- see
# database/migrations/*_create_dispatch_service_role.php.
DISPATCH_SERVICE_DB_PASSWORD=change_me_local_dev_dispatch_service

# Least-privilege, read-only role for apps/realtime-gateway (Go) -- see
# database/migrations/*_create_realtime_gateway_role.php.
REALTIME_GATEWAY_DB_PASSWORD=change_me_local_dev_realtime_gateway
