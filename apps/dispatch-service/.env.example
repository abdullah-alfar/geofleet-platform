# Local development environment for dispatch-service.
# Copy to `.env` and `export $(grep -v '^#' .env | xargs)` before running.
# Points at the same Phase 1 infrastructure core-api and location-service
# use, via host-exposed ports.

HTTP_PORT=8082
LOG_LEVEL=info

# Write-scoped Postgres role created by apps/core-api's
# 2026_08_09_100000_create_dispatch_service_role.php migration. The
# password here must match DISPATCH_SERVICE_DB_PASSWORD in
# apps/core-api/.env — same credential, two services.
DISPATCH_SERVICE_POSTGRES_DSN=postgres://dispatch_service:change_me_local_dev_dispatch_service@127.0.0.1:55432/core_api?sslmode=disable

REDIS_ADDR=127.0.0.1:63790
REDIS_PASSWORD=change_me_local_dev

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
DISPATCH_CONSUMER_GROUP=dispatch-service

# Isolated consumer group for the ride.requested.v1.retry topic — see
# docs/decisions/0007-retry-dlq-strategy.md. Kept separate from
# DISPATCH_CONSUMER_GROUP on purpose (its handler sleeps a multi-minute
# backoff per message; must never share a partition with live traffic).
DISPATCH_RETRY_CONSUMER_GROUP=dispatch-service-retry

# Geo-cell indexing — see docs/decisions/0005-geohash-and-dispatch-db-access.md
GEOHASH_PRECISION=6
STALE_LOCATION_AGE=60s

DRIVER_PROFILE_CACHE_TTL=30s

OFFER_TTL=15s
MAX_OFFER_ATTEMPTS=5
EXPIRY_SWEEP_INTERVAL=2s
