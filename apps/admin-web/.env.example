# Local development environment for admin-web.
# Copy to `.env` before running `npm run dev`.

# admin-api's base URL — see apps/admin-api/.env's HTTP_PORT (3001).
# Every request this app makes goes here, including login — admin-api is
# fully independent of core-api (see
# docs/decisions/0011-admin-api-independent-service.md).
NUXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3001
