# -----------------------------------------------------------------------------
# Local infrastructure environment. Copy to `.env` and adjust as needed.
# Never commit the real `.env` file — it is gitignored.
# -----------------------------------------------------------------------------

# Compose project name (container name prefix)
COMPOSE_PROJECT_NAME=ridehailing

# Default region for local development (see docs/architecture/system-context.md)
REGION_ID=amman

# --- PostgreSQL / PostGIS -----------------------------------------------------
POSTGRES_DB=core_api
POSTGRES_USER=core_api
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- Redis ---------------------------------------------------------------------
# requirepass is passed to the container via command-line flag, sourced from here.
REDIS_PASSWORD=change_me_local_dev
REDIS_PORT=6379
REDIS_HOST=redis

# --- Kafka (single-node KRaft broker, local dev only) ---------------------------
# Internal (container-to-container) bootstrap address.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Host-exposed port for tools/services running outside Docker (e.g. `go run` locally).
KAFKA_EXTERNAL_PORT=9094
# Fixed cluster ID for local dev KRaft storage. Generated once via
# `kafka-storage.sh random-uuid`; safe to keep constant for a non-shared local cluster.
KAFKA_CLUSTER_ID=NfHdIwpJTiiFbgdR_NCWIw

# Kafka has no authentication in local dev. See docs/architecture/security.md
# (added in a later phase) for the auth-ready configuration plan.
